// ============================================================
//  校园网助手 · Win32 版本资源
//
//  ⚠️ 为什么需要这个文件：
//     不嵌版本资源的话，exe 的「属性 → 详细信息」里版本号是空的，
//     Windows 也拿不到任何产品信息。传播出去之后，
//     有人反馈问题你**没法确认对方手上是哪个版本**（2026-10-01 补上）。
//
//  ⚠️ 改版本号时**必须同时改两个地方**：
//     ① 这个文件的 FILEVERSION / PRODUCTVERSION / FileVersion / ProductVersion
//     ② MainWindow.cs 里的 VersionText 常量（界面上「关于」显示的那个）
//     两处不一致会导致「界面显示的版本」和「文件属性里的版本」对不上。
//
//  ⚠️ 编码：文件存为 UTF-8，靠下面这行 pragma 告诉 rc.exe 按 UTF-8 读。
//     删掉它的话中文会变乱码（rc.exe 默认按系统 ANSI 读）。
//
//  ⚠️ 这里**故意不 #include <winver.h>**：
//     那些头文件只在装了 Windows SDK 的机器上才有，而 rc.exe 又不会自己去
//     SDK 的 Include 目录里找（实测报 RC1015: cannot open include file 'winver.h'）。
//     这个 .rc 其实只需要几个常量，直接写成数值就完事，构建不再依赖 SDK 头文件：
//         VOS_NT_WINDOWS32 = 0x00040004    VFT_APP = 0x00000001
//         VFT2_UNKNOWN     = 0x00000000    VS_VERSION_INFO = 1
//
//  编译方式见 build_check.bat（自动找 rc.exe 编译成 version.res，
//  再用 csc 的 /win32res 嵌进去；找不到 rc.exe 会自动降级为只嵌图标）。
// ============================================================

#pragma code_page(65001)

// ---- 程序图标 ----
// 路径相对于本 .rc 文件所在目录（assets/）
1 ICON "logo.ico"

// ---- 版本信息 ----
// 版本号：2.1.1.0（四段式，最后一段留给以后的热修）
1 VERSIONINFO
FILEVERSION     2,1,1,0
PRODUCTVERSION  2,1,1,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x00040004L
FILETYPE        0x00000001L
FILESUBTYPE     0x00000000L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0804 = 简体中文，04b0 = Unicode
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "校园网助手（个人作品）"
            VALUE "FileDescription",  "校园网助手 —— 轻量的校园网连接管理工具"
            VALUE "FileVersion",      "2.1.1.0"
            VALUE "InternalName",     "CampusNetHelper"
            VALUE "LegalCopyright",   "免费使用 · 不含任何广告与信息收集"
            VALUE "OriginalFilename", "校园网助手.exe"
            VALUE "ProductName",      "校园网助手"
            VALUE "ProductVersion",   "2.1.1"
            VALUE "Comments",         "C# + WPF 单文件 · 绿色免安装"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
